# Copia a apps/api/.env (o exporta en el entorno de Railway).

# Base de datos (misma que la raíz para Prisma)
DATABASE_URL="postgresql://savia:savia@localhost:5432/savia?schema=public"

# Puerto del servidor GraphQL (4001 para no chocar con Equitrack, que usa 4000)
PORT=4001

# Auth0 — validación del JWT (RS256).
# DÉJALO COMENTADO en desarrollo: sin AUTH0_DOMAIN se activa el modo dev
# (identificación por header x-dev-user-email, ver src/context.ts).
# Descoméntalo y pon valores reales solo cuando integres un tenant de Auth0.
# AUTH0_DOMAIN="tu-tenant.us.auth0.com"
# AUTH0_AUDIENCE="https://api.savia.app"

# Worker de notificaciones
# Cadencia del cron (por defecto cada 15 min)
NOTIFY_CRON="*/15 * * * *"
# Token de acceso de Expo (opcional, para límites de envío más altos)
EXPO_ACCESS_TOKEN=""
